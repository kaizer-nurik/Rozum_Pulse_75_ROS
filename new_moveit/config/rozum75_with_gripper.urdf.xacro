<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rozum75_with_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rozum75_with_gripper urdf file -->
    <xacro:include filename="$(find rozum_pulse_75_control)/urdf/rozum_pulse_75_with_gripper.xacro" />

    <!-- Import control_xacro
    <xacro:include filename="rozum75_with_gripper.ros2_control.xacro" />


    <xacro:rozum75_with_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/> -->

</robot>
